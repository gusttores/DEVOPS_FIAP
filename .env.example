# =============================================================================
# Variáveis de ambiente do GovAmbiental.API
#
# Copie este arquivo e preencha os valores:
#   cp .env.example .env            # ambiente local
#   cp .env.example .env.staging    # staging  (API_PORT=8081)
#   cp .env.example .env.prod       # produção (API_PORT=8080)
#
# Nenhum .env real vai para o Git (ver .gitignore). No pipeline, estes valores
# vêm de GitHub Secrets/Variables; no Kubernetes, de Secret/ConfigMap.
# =============================================================================

# ---- Imagem publicada pelo pipeline (GitHub Container Registry) ----
IMAGE_NAME=ghcr.io/gusttores/govambiental-api
IMAGE_TAG=staging          # staging | latest | <sha do commit>
PULL_POLICY=always         # use "never" para rodar uma imagem construída localmente

# ---- Banco de dados (SQL Server 2022) ----
SA_PASSWORD=Gov@mbiental2026      # mínimo 8 caracteres, maiúscula, minúscula, número e símbolo
DB_NAME=GovAmbientalDb
DB_PORT=1433
# Macs com Apple Silicon: a imagem do SQL Server só existe para amd64 (roda emulada).
DB_PLATFORM=linux/amd64

# ---- API ----
API_PORT=8080              # 8080 em produção, 8081 em staging
APP_VERSION=dev

# ---- Segurança / JWT ----
JWT_KEY=chave-super-secreta-gov-ambiental-fiap-2026-minimo-32-bytes!
JWT_ISSUER=GovAmbiental.API
JWT_AUDIENCE=GovAmbiental.Clients

# ---- Credencial do auditor (login que emite o token) ----
AUTH_EMAIL=auditor@govambiental.com
AUTH_PASSWORD=Auditor@123
